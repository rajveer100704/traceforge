# Copy to .env and adjust. PLACEHOLDERS ONLY — never commit real secrets.
TRACEFORGE_ENV=local
TRACEFORGE_DATA_DIR=.traceforge
# TRACEFORGE_DATABASE_URL=postgresql+psycopg://traceforge:change-me-local-only@localhost:5432/traceforge
TRACEFORGE_QUEUE_BACKEND=inline
TRACEFORGE_REDIS_URL=redis://localhost:6379/0
TRACEFORGE_STORAGE_BACKEND=local
TRACEFORGE_S3_ENDPOINT_URL=http://localhost:9000
TRACEFORGE_S3_BUCKET=traceforge
TRACEFORGE_S3_ACCESS_KEY_ID=traceforge
TRACEFORGE_S3_SECRET_ACCESS_KEY=change-me-local-only
TRACEFORGE_SANDBOX_PROVIDER=local
TRACEFORGE_SANDBOX_IMAGE=traceforge-sandbox:0.1
TRACEFORGE_ALLOW_UNTRUSTED_LOCAL_EXECUTION=false
# Required when TRACEFORGE_ENV=prod. Clients send it as the X-API-Key header.
TRACEFORGE_API_KEY=
TRACEFORGE_LOG_LEVEL=INFO
TRACEFORGE_OTEL_ENABLED=false
# Model provider secrets are read from the env var named in the provider config, e.g.:
# OPENAI_API_KEY=
POSTGRES_PASSWORD=change-me-local-only
MINIO_ROOT_PASSWORD=change-me-local-only
